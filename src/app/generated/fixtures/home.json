  "faqs": [
    {
      "id": "WlVn2PPdQWBByj8D4SUy",
      "question": "What is GDG Siliguri?",
      "answer": "GDG Siliguri is a community of developers based in Siliguri, serving the North Bengal and Sikkim regions. We are a mix of student and professional developers passionate about learning and sharing knowledge in technology. We host events like tech talks, hackathons, codelabs, and workshops to empower the local tech community.",
      "order": 10
    },
    {
      "id": "KDKU4rWzhIF873RNfJi0",
      "question": "Who can join GDG Siliguri?",
      "answer": "Anyone interested in technology, coding, design or community learning is welcome to join GDG Siliguri! Our group is open to students, professionals, and tech enthusiasts from all backgrounds and skill levels.",
      "order": 20
    },
    {
      "id": "ynNL7SjdRw9uiYDm70UN",
      "question": "Do I need to be a developer to join GDG Siliguri?",
      "answer": "Not at all! While our community focuses on technology, we welcome anyone interested in learning about tech, design regardless of their experience level. We have members ranging from complete beginners to experienced developers, designers and entrepreneurs.",
      "order": 30
    }
