  "testimonials": [
    {
      "id": "Oy4PmABN4D2BgV1VMrzY",
      "name": "Aditya Gurung",
      "title": "Somehow, manifestation worked out!",
      "body": "A year ago, if I had been told that I'd be attending #devfest2022 in my first sem itself, I would have had a good laugh about it. But somehow, manifestation worked out! Had an amazing weekend learning insight sessions from Big Brains like Mr. Senthilkumar Murugesan, Mr. Kazi Haque, Ms. Jyoti Mishra, Rohan Prasad, Mr. Kamesh Sampath, Mr. Rishabh Gupta about FlutterFlow, Kubernetes Architect, Google Cloud, Kotlin Koins, Anthos, Drone CI, etc.",
      "eventLabel": "@Devfest'22",
      "edition": 2022,
      "featured": true,
      "order": 10
    },
    {
      "id": "dLrrWZMVJQKzyY5h04kt",
      "name": "Trisha Senapati",
      "title": "It was an awesome experience to attend DevFest this year!",
      "body": "Flutter or Android App Development was never something I took much interest in, until today, where I was in a session with Bhavik Makwana and Dhrumil Shah. They made it look so easy and interesting. Definitely going to explore more on this! Thank You so much GDG Siliguri to let us have a wonderful experience. It was an awesome experience to attend DevFest this year!",
      "eventLabel": "@Devfest'22",
      "edition": 2022,
      "featured": true,
      "order": 20
    },
    {
      "id": "AJnmdMLYPPFrAPzK4bZF",
      "name": "Shreyasi Talukdar",
      "title": "A great and an amazing event",
      "body": "I attended DevFest2022 Siliguri for the very first time and the experience was great. Thanks GDG Siliguri for giving us such a great and an amazing event. We got a chance to learn so many new things from our amazing speakers Bhavik Makwana Dhrumil Shah Anubhav Singh Jyoti Mishra Abhishek Nandy Rohan Prasad Kazi Haque Rishabh Gupta. Looking forward for more upcoming events.",
      "eventLabel": "@Devfest'22",
      "edition": 2022,
      "featured": true,
      "order": 30
    },
    {
      "id": "CR7tpRcI5GNLEqXBtUSx",
